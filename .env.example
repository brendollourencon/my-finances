# Copie para .env (não versionar). Valores abaixo servem SOMENTE para desenvolvimento local.
DB_ROOT_PASSWORD=root_dev_password
DB_NAME=my_finances
# Se alterar DB_USER, altere também infra/mariadb/init/01-databases.sql
DB_USER=finances
DB_PASSWORD=finances_dev_password
DB_PORT=3306


# Troque por valores aleatórios longos (ex.: openssl rand -hex 32)
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
